<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>FluxDrop</AssemblyName>
    <Version>0.4.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/FluxDrop.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <ProjectReference Include="../FluxDrop.Core/FluxDrop.Core.csproj" />
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
  </ItemGroup>
  <ItemGroup>
    <None
      Update="ThirdParty/**/*"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <None
      Include="../../../build/windows-engines/**/*"
      Link="engines/%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <None
      Include="../../../docs/WINDOWS.md"
      Link="WINDOWS.md"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
