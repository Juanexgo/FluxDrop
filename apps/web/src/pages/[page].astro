---
import Layout from '../layouts/Layout.astro';
import {pages} from '../data/pages';
export function getStaticPaths(){return Object.entries(pages).map(([page, content])=>({params:{page},props:{content}}));}
const {content}=Astro.props;
---
<Layout title={content.title} description={content.intro}>
  <article class="page prose-page"><p class="eyebrow">{content.eyebrow}</p><h1>{content.title}</h1><p class="intro">{content.intro}</p>
  {content.sections.map(([title, text])=><section><h2>{title}</h2><p>{text}</p></section>)}
  <a class="text-link" href="/descarga/">Estado de la descarga ↗</a></article>
</Layout>
