{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FluxDrop stable release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "channel",
    "release"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "channel": {
      "const": "stable"
    },
    "release": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "date",
            "minimumMacOS",
            "architectures",
            "installerURL",
            "size",
            "sha256",
            "releaseNotesURL"
          ],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "minimumMacOS": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+$"
            },
            "architectures": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "arm64",
                  "x86_64"
                ]
              }
            },
            "installerURL": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "size": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "releaseNotesURL": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        }
      ]
    }
  }
}
